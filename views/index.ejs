<!--here we will write HTML code for the layout of our homepage-->
<div class = "index-content">
    <h2 class = "page-header">Recently Added Movies</h2>
    <div class = "imgs-displayed">
        <%movies.forEach(movie => {%>
            <div class ="each-img">
                <a href = "/movies/<%=movie.id%>">
                <img height = "150" width = "150" src = "<%=movie.coverImagePath%>">
                </a>
            </div>
        <%}) %>
    </div>
</div>