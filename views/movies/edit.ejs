<div class = "form-row">
    <h2 class = "page-header">Edit Movie</h2> <!--This is the title of our new movie page-->
    <!--We create our form for our new movies page-->
</div>
<!--We do a method override since we want this form to submit a put request to our server instead of a post request-->
<form action ="/movies/<%=movie.id%>?_method=PUT" method ="POST">
    <%-include('_form_fields')%>
    <div class ="btn-row form-row-end">
        <a class = "btn btn-primary" href = "/movies">Cancel</a>  <!--This button links back to our movies index page-->
        <button class = "btn btn-primary" type = "submit" >Update</button> <!--This submits our form-->
    </div>
</form>